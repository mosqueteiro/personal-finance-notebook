-- allium: 3
-- personal-finance-notebook.allium

-- Scope: Personal Finance Operations Center (v1 MVP)
-- Includes: Account liquidity tracking, transaction ingestion from files, transaction categorization, ledger filtering, budget pacing.
-- Excludes:
--   - Direct API connections to banks (Plaid, etc.)
--   - Real-time stock/crypto price scraping
--   - Multi-user authentication or state
--   - Advanced ML auto-categorization (deferred to v2)

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum TransactionType { income | expense }

enum BudgetPeriod { monthly | yearly }

enum StatementFormat { csv | pdf }

enum StatementStatus { uploaded | extracted | confirmed | rejected }

enum TransactionStatus { pending_confirmation | confirmed | rejected }

enum AccountStatus { active | closed }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Category {
    name: String
    created_at: Timestamp
}

entity Account {
    name: String
    institution: String
    status: AccountStatus
    starting_balance: Decimal
    low_balance_threshold: Decimal
    created_at: Timestamp

    transactions: Transaction with account = this
    confirmed_transactions: transactions where status = confirmed

    current_balance: Decimal = starting_balance + net_balance(confirmed_transactions)
    is_low_balance: Boolean = current_balance < low_balance_threshold

    transitions status {
        active -> closed
        closed -> active
        terminal: none
    }
}

entity AccountStatement {
    account: Account
    file_name: String
    format: StatementFormat
    status: StatementStatus
    uploaded_at: Timestamp
    start_date: Timestamp?
    end_date: Timestamp?
    content_hash: String?
    ending_balance: Decimal?

    transactions: Transaction with statement = this

    transitions status {
        uploaded -> extracted
        extracted -> confirmed
        extracted -> rejected
        terminal: confirmed, rejected
    }
}

entity Transaction {
    account: Account
    statement: AccountStatement?
    status: TransactionStatus
    date: Timestamp
    amount: Decimal
    type: TransactionType
    merchant: String
    description: String?
    category: Category?
    manually_categorized: Boolean
    created_at: Timestamp

    transitions status {
        pending_confirmation -> confirmed
        pending_confirmation -> rejected
        terminal: confirmed, rejected
    }
}

entity CategorizationRule {
    merchant_keyword: String
    target_category: Category
    created_at: Timestamp
}

entity Budget {
    name: String
    target_category: Category?
    amount: Decimal
    period: BudgetPeriod
    created_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule HandleUploadStatement {
    when: UploadStatement(account, file_path, format)
    requires: not exists AccountStatement where account = account and content_hash = hash_file(file_path)
    ensures: AccountStatement.created(
        account: account,
        file_name: file_path,
        format: format,
        status: uploaded,
        uploaded_at: now,
        content_hash: hash_file(file_path)
    )
}

rule HandleExtractStatement {
    when: ExtractStatement(statement)
    requires: statement.status = uploaded
    ensures: statement.status = extracted
}

rule StatementExtracted {
    when: statement: AccountStatement.status transitions_to extracted
    let entries = extract_statement_entries(statement)
    ensures:
        for entry in entries:
            Transaction.created(
                statement: statement,
                account: statement.account,
                date: entry.date,
                amount: entry.amount,
                type: entry.type,
                merchant: entry.merchant,
                description: entry.description,
                status: pending_confirmation,
                manually_categorized: false
            )
}

rule HandleConfirmStatement {
    when: ConfirmStatement(statement)
    requires: statement.status = extracted
    ensures: statement.status = confirmed
}

rule StatementConfirmed {
    when: statement: AccountStatement.status transitions_to confirmed
    for t in statement.transactions:
        requires: t.status = pending_confirmation
        ensures: t.status = confirmed
    let computed_balance = statement.account.current_balance
    ensures:
        if statement.ending_balance != null and statement.ending_balance != computed_balance:
            ReconciliationMismatch(statement, statement.ending_balance, computed_balance)
}

rule HandleRejectStatement {
    when: RejectStatement(statement)
    requires: statement.status = extracted
    ensures: statement.status = rejected
}

rule StatementRejected {
    when: statement: AccountStatement.status transitions_to rejected
    for t in statement.transactions:
        requires: t.status = pending_confirmation
        ensures: t.status = rejected
}

rule AutoCategorizeTransaction {
    when: transaction: Transaction.created
    requires: transaction.category = null
    ensures: transaction.category = categorize(transaction.merchant)

    @guidance
        -- categorize(merchant) is a black box function that applies CategorizationRules
        -- to the merchant string. Match mode: case-insensitive substring.
        -- Priority: longest matching keyword wins. Fallback: returns "Uncategorized" Category.
}

rule HandleCreateCategorizationRule {
    when: CreateCategorizationRule(keyword, category)
    ensures: CategorizationRule.created(
        merchant_keyword: keyword,
        target_category: category,
        created_at: now
    )
}

rule HandleReapplyCategorizationRules {
    when: ReapplyCategorizationRules(transaction)
    requires: transaction.status = confirmed
    requires: not transaction.manually_categorized
    ensures: transaction.category = categorize(transaction.merchant)
}

rule HandleEditTransactionCategory {
    when: EditTransactionCategory(transaction, category)
    requires: transaction.status = confirmed
    ensures:
        transaction.category = category
        transaction.manually_categorized = true
}

rule HandleCloseAccount {
    when: CloseAccount(account)
    requires: account.status = active
    ensures: account.status = closed
}

rule HandleReopenAccount {
    when: ReopenAccount(account)
    requires: account.status = closed
    ensures: account.status = active
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor User {
    -- The sole owner of the financial data and system.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface DataIngestion {
    facing user: User

    let statements = AccountStatements

    exposes:
        for s in statements:
            s.file_name
            s.format
            s.status
            s.uploaded_at

    provides:
        UploadStatement(user, account, file_path, format)
        ExtractStatement(user, statement)
            when statement.status = uploaded
        ConfirmStatement(user, statement)
            when statement.status = extracted
        RejectStatement(user, statement)
            when statement.status = extracted
}

surface CategorizationManagement {
    facing user: User

    let rules = CategorizationRules

    exposes:
        for rule in rules:
            rule.merchant_keyword
            rule.target_category

    provides:
        CreateCategorizationRule(user, keyword, category)
        EditTransactionCategory(user, transaction, category)
        ReapplyCategorizationRules(user, transaction)
}

surface AccountManagement {
    facing user: User

    let accounts = Accounts

    exposes:
        for a in accounts:
            a.name
            a.institution
            a.starting_balance
            a.current_balance
            a.status

    provides:
        CloseAccount(user, account)
            when account.status = active
        ReopenAccount(user, account)
            when account.status = closed
}

surface BudgetAndPacing {
    facing user: User

    let budgets = Budgets
    let confirmed_transactions = Transactions where status = confirmed
    let accounts = Accounts where status = active

    exposes:
        for b in budgets:
            b.name
            b.target_category
            b.amount
            b.period
        for t in confirmed_transactions:
            t.date
            t.amount
            t.type
            t.merchant
            t.category
        for a in accounts:
            a.name
            a.current_balance
            a.is_low_balance

    @guarantee SpendingVsBudget
        -- User sees total spending vs budget for the selected period.
        -- User sees category-specific spending vs budget for the selected period.

    @guarantee LowBalanceAlerts
        -- User sees alerts for any accounts where is_low_balance is true.

    @guidance
        -- Budget period: current calendar month when period = monthly,
        -- current calendar year when period = yearly (v1).
        -- Pacing math: linear day-of-period projection.
        -- Formula: spent_so_far / days_elapsed * days_in_period.
        -- Overall budget (null target_category) rolls up all categories.
        -- Category budgets scope to their target_category only.
        -- No rollover in v1.
}

